<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListPreference
        android:title="@string/preference_title_language"
        android:key="setting_multilingual"
        android:summary="@string/preference_description_language"
        android:defaultValue="false"/>
    <PreferenceScreen
        android:title="@string/preference_title_ai"
        android:key="setting_ai_screen"
        android:summary="@string/preference_description_ai"/>
    <CheckBoxPreference
        android:title="@string/preference_title_multiplayer_variables_enabled"
        android:key="setting_multiplayer_variables_enabled"
        android:summary="@string/preference_description_multiplayer_variables_enabled"
        android:defaultValue="false"/>
    <Preference
        android:title="@string/preference_title_enable_embroidery_bricks"
        android:key="setting_embroidery_bricks_preference"
        android:summary="@string/preference_description_embroidery_bricks"/>
    <CheckBoxPreference
        android:title="@string/preference_title_old_drag"
        android:key="setting_old_drag"
        android:summary="@string/preference_title_old_dragd"
        android:defaultValue="false"/>
    <CheckBoxPreference
        android:title="PC Mode"
        android:key="pref_pc_mode_enabled"
        android:summary="@string/preference_title_pcmode"
        android:defaultValue="false"/>
    <PreferenceScreen
        android:title="@string/free_window_mode"
        android:key="setting_workspace_screen"
        android:summary="@string/free_window_mode_sum">
        <CheckBoxPreference
            android:title="@string/free_window_base"
            android:key="pref_free_window_mode"
            android:summary=""
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/free_window_mode_project"
            android:key="pref_workspace_project_level"
            android:summary="@string/free_window_mode_project_sum"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/free_window_mode_stage"
            android:key="pref_workspace_stage"
            android:summary="@string/free_window_mode_stage_sum"
            android:defaultValue="false"/>
    </PreferenceScreen>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_embroidery_bricks"
        android:key="setting_embroidery_bricks_checkbox_preference"
        android:summary="@string/preference_description_embroidery_bricks"
        android:defaultValue="@string/FEATURE_EMBROIDERY_PREFERENCES_ENABLED"/>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_plot_bricks"
        android:key="setting_plot_bricks"
        android:summary="@string/preference_description_plot_bricks"
        android:defaultValue="@string/FEATURE_EMBROIDERY_PREFERENCES_ENABLED"/>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_neural_bricks"
        android:key="setting_neural_bricks"
        android:summary="@string/preference_description_neural_bricks"
        android:defaultValue="@string/FEATURE_EMBROIDERY_PREFERENCES_ENABLED"/>
    <CheckBoxPreference
        android:title="@string/pocketensor"
        android:key="setting_pocketensor_bricks"
        android:summary="@string/preference_description_pocketensor_bricks"
        android:defaultValue="@string/FEATURE_EMBROIDERY_PREFERENCES_ENABLED"/>
    <CheckBoxPreference
        android:title="@string/fast2d"
        android:key="setting_fast2d_bricks"
        android:summary="@string/preference_description_fast2d_bricks"
        android:defaultValue="@string/FEATURE_EMBROIDERY_PREFERENCES_ENABLED"/>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_threed_bricks"
        android:key="setting_threed_bricks"
        android:summary="@string/preference_description_threed"
        android:defaultValue="@string/FEATURE_EMBROIDERY_PREFERENCES_ENABLED"/>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_internet_bricks"
        android:key="setting_internet_bricks"
        android:summary="@string/preference_description_internet_bricks"
        android:defaultValue="@string/FEATURE_EMBROIDERY_PREFERENCES_ENABLED"/>
    <PreferenceScreen
        android:title="@string/preference_title_enable_mindstorms_nxt_bricks"
        android:key="setting_nxt_screen"
        android:summary="@string/preference_description_mindstorms_nxt_bricks"/>
    <PreferenceScreen
        android:title="@string/preference_title_enable_mindstorms_ev3_bricks"
        android:key="setting_ev3_screen"
        android:summary="@string/preference_description_mindstorms_ev3_bricks"/>
    <PreferenceScreen
        android:title="@string/preference_title_enable_quadcopter_bricks"
        android:key="settings_drone_screen"
        android:summary="@string/preference_description_quadcopter_bricks"/>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_jumpingsumo_bricks"
        android:key="setting_parrot_jumping_sumo_bricks"
        android:summary="@string/preference_description_jumpingsumo_bricks"
        android:defaultValue="false"/>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_arduino_bricks"
        android:key="setting_arduino_bricks"
        android:summary="@string/preference_description_arduino_bricks"
        android:defaultValue="false"/>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_nfc_bricks"
        android:key="setting_nfc_bricks"
        android:summary="@string/preference_description_nfc_bricks"
        android:defaultValue="false"/>
    <PreferenceScreen
        android:title="@string/preference_title_enable_raspi_bricks"
        android:key="settings_raspberry_screen"
        android:summary="@string/preference_description_raspi_bricks"/>
    <Preference
        android:title="@string/preference_title_enable_phiro_bricks"
        android:key="setting_enable_phiro_bricks_preference"
        android:summary="@string/preference_description_phiro_bricks"/>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_phiro_bricks"
        android:key="setting_enable_phiro_bricks_checkbox_preference"
        android:summary="@string/preference_description_phiro_bricks"
        android:defaultValue="@string/FEATURE_PHIRO_PREFERENCES_ENABLED"/>
    <CheckBoxPreference
        android:title="@string/preference_title_cast_feature_globally_enabled"
        android:key="setting_cast_globally_enabled"
        android:summary="@string/preference_description_cast_feature_globally_enabled"
        android:defaultValue="false"/>
    <PreferenceScreen
        android:title="@string/preference_title_accessibility"
        android:key="setting_accessibility_screen"
        android:summary="@string/preference_description_accessibility"/>
    <PreferenceScreen
        android:title="@string/preference_title_block_grouping"
        android:key="setting_block_grouping_screen"
        android:summary="@string/preference_description_block_grouping">
        <CheckBoxPreference
            android:title="@string/preference_title_grouping_event"
            android:key="pref_grouping_event"
            android:summary="@string/preference_description_grouping_event"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/preference_title_grouping_control"
            android:key="pref_grouping_control"
            android:summary="@string/preference_description_grouping_control"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/preference_title_grouping_motion"
            android:key="pref_grouping_motion"
            android:summary="@string/preference_description_grouping_motion"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/preference_title_grouping_sound"
            android:key="pref_grouping_sound"
            android:summary="@string/preference_description_grouping_sound"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/preference_title_grouping_looks"
            android:key="pref_grouping_looks"
            android:summary="@string/preference_description_grouping_looks"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/preference_title_grouping_data"
            android:key="pref_grouping_data"
            android:summary="@string/preference_description_grouping_data"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/preference_title_grouping_device"
            android:key="pref_grouping_device"
            android:summary="@string/preference_description_grouping_device"
            android:defaultValue="false"/>
        <CheckBoxPreference
            android:title="@string/preference_title_grouping_threed"
            android:key="pref_grouping_threed"
            android:summary="@string/preference_description_grouping_threed"
            android:defaultValue="true"/>
    </PreferenceScreen>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_hints"
        android:key="setting_enable_hints"
        android:summary="@string/preference_description_hints"
        android:defaultValue="@string/SNACKBAR_HINTS_ENABLED"/>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_test_bricks"
        android:key="setting_test_bricks"
        android:summary="@string/preference_description_test_bricks"
        android:defaultValue="@string/DEBUG_MODE"/>
    <CheckBoxPreference
        android:title="1 APRIL"
        android:key="pref_1_april_enabled"
        android:summary=":]"
        android:defaultValue="false"/>
    <CheckBoxPreference
        android:title="@string/code_analysis_title"
        android:key="pref_code_analysis_enabled"
        android:summary="@string/code_analysis_desc"
        android:defaultValue="true"/>
    <PreferenceCategory android:title="@string/community_title">
        <Preference
            android:title="@string/acc_title"
            android:key="setting_community_login"
            android:summary="@string/acc_desc"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/github_integration">
        <Preference
            android:title="@string/github_account"
            android:key="setting_github_login"
            android:summary="@string/github_not_logged_in"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/additions"
        android:key="category_additions">
        <PreferenceScreen
            android:icon="@android:drawable/ic_menu_add"
            android:title="@string/plugins"
            android:key="setting_plugins_screen"
            android:summary="@string/plugins_desc"/>
        <PreferenceScreen
            android:icon="@android:drawable/ic_menu_add"
            android:title="IDE"
            android:key="setting_ide_screen"
            android:summary="@string/ide_desc"/>
    </PreferenceCategory>
    <CheckBoxPreference
        android:title="@string/preference_title_enable_crash_reports"
        android:key="setting_enable_crash_reports"
        android:summary="@string/preference_description_crash_reports"
        android:defaultValue="true"/>
    <CheckBoxPreference
        android:title="@string/pref_developer_mode_title"
        android:key="setting_developer_mode_enabled"
        android:summary="@string/pref_developer_mode_summary"
        android:defaultValue="false"/>
    <PreferenceScreen
        android:title="@string/pref_ai_settings_title"
        android:key="setting_kove_ai_screen"
        android:dependency="setting_developer_mode_enabled">
        <CheckBoxPreference
            android:title="@string/pref_ai_autocomplete_title"
            android:key="setting_kove_ai_autocomplete"
            android:summary="@string/pref_ai_autocomplete_summary"
            android:defaultValue="false"/>
    </PreferenceScreen>
    <PreferenceCategory android:title="@string/recovery">
        <Preference
            android:title="@string/recovery_btn"
            android:key="setting_recover_projects"
            android:summary="@string/recovery_desc"/>
    </PreferenceCategory>
</PreferenceScreen>

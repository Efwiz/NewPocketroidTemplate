<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout style="@style/BrickContainer.Threed.Small">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/brick_set_free_camera"
            style="@style/BrickText.SingleLine"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

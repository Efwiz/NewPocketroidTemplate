<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_listen_micro_layout"
        style="@style/BrickContainer.Sound.Medium">
        <include layout="@layout/icon_brick_category_sound"/>
        <TextView
            android:id="@+id/brick_listen_micro_label"
            android:text="@string/brick_listen_micro"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_listen_micro_edit_text"
            app:layout_newLine="true"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_listen_micro_label2"
            android:text="@string/brick_listen_micro2"
            style="@style/BrickText.SingleLine"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

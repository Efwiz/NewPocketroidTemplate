<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_set_object_shader_uniform_layout"
        style="@style/BrickContainer.Threed.Big">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/set_object_shader_uniform"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/object_shader_id"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_object_shader_uniform_id"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/object_shader_uniform_name"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_object_shader_uniform_name"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/object_shader_uniform_val1"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_object_shader_uniform_val1"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/object_shader_uniform_val2"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_object_shader_uniform_val2"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/object_shader_uniform_val3"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_object_shader_uniform_val3"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

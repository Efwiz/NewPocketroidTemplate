<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_delete_from_apk_layout"
        style="@style/BrickContainer.File.Medium">
        <include layout="@layout/icon_brick_category_file"/>
        <TextView
            android:text="@string/brick_del_apk_title"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_del_apk_path"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_del_apk_edit_path"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_del_apk_pattern"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_del_apk_edit_pattern"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_apply_impulse_layout"
        style="@style/BrickContainer.Motion.Medium">
        <include layout="@layout/icon_brick_category_motion"/>
        <TextView
            android:text="@string/brick_apply_impulse"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_impulse_x"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_impulse_x_edit_text"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_impulse_y"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_impulse_y_edit_text"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

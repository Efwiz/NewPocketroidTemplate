<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_big_ask_layout"
        style="@style/BrickContainer.Look.Big">
        <include layout="@layout/icon_brick_category_look"/>
        <TextView
            android:id="@+id/brick_ask_label"
            android:text="@string/brick_ask_label"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_big_ask_question"
            android:layout_width="match_parent"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_ask_label2"
            android:text="@string/brick_ask_label2"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_big_ask_clue"
            android:layout_width="match_parent"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_ask_label3"
            android:text="@string/brick_ask_label3"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_big_ask_ok"
            android:layout_width="match_parent"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_ask_label4"
            android:text="@string/brick_ask_label4"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_big_ask_canel"
            android:layout_width="match_parent"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_ask_label5"
            android:text="@string/brick_ask_label5"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_big_ask_default"
            android:layout_width="match_parent"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_ask_store_label"
            android:text="@string/brick_ask_store"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_big_ask_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            app:layout_newLine="true"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

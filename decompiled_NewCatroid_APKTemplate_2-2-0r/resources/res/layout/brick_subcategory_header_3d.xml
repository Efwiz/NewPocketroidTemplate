<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/brick_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/BrickContainer.Threed.Small">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/solid_white"
            android:id="@+id/brick_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BrickText.SingleLine"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/solid_white"
            android:id="@+id/brick_header_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▼"
            style="@style/BrickText.SingleLine"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_notification_create_layout"
        style="@style/BrickContainer.Device.Big">
        <include layout="@layout/icon_brick_category_device"/>
        <TextView
            android:text="@string/brick_notification_create_title"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_notification_id"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_notif_create_id"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_notification_channel"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_notif_create_channel"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_notification_header"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_notif_create_title"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_notification_text"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_notif_create_text"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_notification_large_icon"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_notif_create_icon"
            style="@style/BrickEditText"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_newLine="true">
            <TextView
                android:text="@string/brick_notification_importance"
                style="@style/BrickText.SingleLine"/>
            <Spinner
                android:id="@+id/brick_notif_create_importance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <CheckBox
            android:textColor="#ffffff"
            android:id="@+id/brick_notif_create_ongoing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brick_notification_ongoing"
            android:buttonTint="#ffffff"
            app:layout_newLine="true"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

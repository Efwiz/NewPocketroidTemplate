<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:background="@color/app_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false">
    <RelativeLayout
        android:background="@color/app_background"
        android:layout_width="400dp"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:paddingBottom="100dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:id="@+id/currentProjectLayout"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_margin="16dp"
                    app:cardBackgroundColor="@color/button_background"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="6dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageView
                            android:id="@+id/projectImageView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                        <ImageView
                            android:background="#33000000"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <ImageView
                            android:id="@+id/editProject"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/ic_edit_circle"
                            android:layout_centerInParent="true"
                            app:tint="@color/solid_white"/>
                        <ImageView
                            android:id="@+id/playProject"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_margin="16dp"
                            android:src="@drawable/ic_play_circle"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="24dp"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnWeb"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginHorizontal="16dp"
                    app:cardBackgroundColor="@color/button_background"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/landing_page_icons"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_menu_web"
                        android:drawablePadding="16dp"
                        app:drawableEndCompat="@drawable/ic_arrow_forward_vector"
                        app:drawableStartCompat="@drawable/code_24px"/>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnCommunity"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginHorizontal="16dp"
                    app:cardBackgroundColor="@color/button_background"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/landing_page_icons"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_menu_community"
                        android:drawablePadding="16dp"
                        app:drawableEndCompat="@drawable/ic_arrow_forward_vector"
                        app:drawableStartCompat="@drawable/language_24px"/>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnNewProjectFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:src="@drawable/ic_plus"
            android:layout_alignParentBottom="true"
            android:contentDescription="@string/main_menu_new"
            android:layout_alignParentEnd="true"
            app:backgroundTint="@color/button_background"
            app:elevation="8dp"
            app:fabCustomSize="65dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.NewCatroid.FAB"
            app:tint="@color/solid_white"/>
    </RelativeLayout>
    <View
        android:background="?attr/dividerHorizontal"
        android:layout_width="1dp"
        android:layout_height="match_parent"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/pc_project_list_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:background="@color/app_background_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_content_coordinator"
        android:background="@color/app_background_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <GridLayout
                android:orientation="horizontal"
                android:id="@+id/camera_controls"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="16dp"
                android:rowCount="2"
                android:columnCount="3"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_percent="0.22"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.32">
                <Button
                    android:id="@+id/btn_cam_q"
                    android:layout_column="0"
                    android:text="Q"
                    android:layout_row="0"
                    style="@style/Widget.App.Button.CameraControl"/>
                <Button
                    android:id="@+id/btn_cam_w"
                    android:layout_column="1"
                    android:text="W"
                    android:layout_row="0"
                    style="@style/Widget.App.Button.CameraControl"/>
                <Button
                    android:id="@+id/btn_cam_e"
                    android:layout_column="2"
                    android:text="E"
                    android:layout_row="0"
                    style="@style/Widget.App.Button.CameraControl"/>
                <Button
                    android:id="@+id/btn_cam_a"
                    android:layout_column="0"
                    android:text="A"
                    android:layout_row="1"
                    style="@style/Widget.App.Button.CameraControl"/>
                <Button
                    android:id="@+id/btn_cam_s"
                    android:layout_column="1"
                    android:text="S"
                    android:layout_row="1"
                    style="@style/Widget.App.Button.CameraControl"/>
                <Button
                    android:id="@+id/btn_cam_d"
                    android:layout_column="2"
                    android:text="D"
                    android:layout_row="1"
                    style="@style/Widget.App.Button.CameraControl"/>
            </GridLayout>
            <Button
                android:textStyle="bold"
                android:id="@+id/btn_cam_shift"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="SHIFT"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/camera_controls"
                app:layout_constraintStart_toEndOf="@+id/camera_controls"
                app:layout_constraintTop_toTopOf="@+id/camera_controls"
                app:layout_constraintWidth_percent="0.15"
                style="@style/Widget.App.Button.CameraControl"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.appbar.AppBarLayout
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:background="@color/toolbar_background"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
                app:title="@string/editor_3d_title"
                app:titleTextColor="@color/solid_white"/>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:layout_gravity="end|center_vertical"
            android:orientation="vertical"
            android:id="@+id/quick_actions_panel"
            android:background="@drawable/bg_quick_actions_panel"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:elevation="8dp">
            <ImageButton
                android:id="@+id/btn_quick_duplicate"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_add"
                android:contentDescription="Duplicate"
                app:tint="@color/solid_white"/>
            <ImageButton
                android:id="@+id/btn_quick_move_to_cam"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Move to Cam"
                app:tint="@color/solid_white"/>
            <ImageButton
                android:id="@+id/btn_quick_rotate_to_cam"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:src="@android:drawable/ic_menu_rotate"
                android:contentDescription="Rotate to Camera"
                app:tint="@color/solid_white"/>
            <ImageButton
                android:id="@+id/btn_quick_focus"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:src="@android:drawable/ic_menu_mylocation"
                android:contentDescription="Focus"
                app:tint="@color/solid_white"/>
            <ImageButton
                android:id="@+id/btn_quick_inspector"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:contentDescription="Inspector"
                app:tint="@color/solid_white"/>
            <View
                android:background="@color/separator"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="6dp"/>
            <ImageButton
                android:id="@+id/btn_quick_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="Delete"
                app:tint="#ff5252"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.cardview.widget.CardView
        android:theme="@style/ThemeOverlay.AppCompat.Dark"
        android:layout_gravity="start"
        android:id="@+id/left_drawer"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/solid_white"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_3d_hierarchy"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"/>
                <ImageButton
                    android:id="@+id/btn_undo"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icon_undo"
                    app:tint="@color/accent"/>
                <ImageButton
                    android:id="@+id/btn_redo"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/icon_redo"
                    android:layout_marginStart="8dp"
                    app:tint="@color/accent"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/solid_white"
                    android:textColorHint="@color/text_secondary"
                    android:id="@+id/hierarchy_search"
                    android:background="@drawable/bg_inspector_input"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:hint="@string/editor_3d_search_hint"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"/>
                <ImageButton
                    android:id="@+id/btn_mass_delete"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_delete"
                    android:contentDescription="Delete all found"
                    android:layout_marginStart="8dp"
                    app:tint="#ff5252"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/hierarchy_recyclerview"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="8dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/button_background"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:textColor="@color/app_background_dark"
                    android:id="@+id/btn_add_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/editor_3d_add_empty"
                    android:backgroundTint="@color/accent"
                    style="@style/Widget.AppCompat.Button.Colored"/>
                <Button
                    android:textColor="@color/solid_white"
                    android:id="@+id/btn_add_cube"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/editor_3d_add_cube"
                    android:backgroundTint="@color/toolbar_background"
                    style="@style/Widget.AppCompat.Button.Colored"/>
                <Button
                    android:textColor="@color/solid_white"
                    android:id="@+id/btn_add_sphere"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/editor_3d_add_sphere"
                    android:backgroundTint="@color/toolbar_background"
                    style="@style/Widget.AppCompat.Button.Colored"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:theme="@style/ThemeOverlay.AppCompat.Dark"
        android:layout_gravity="end"
        android:id="@+id/right_drawer"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="310dp"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/solid_white"
                android:id="@+id/inspector_title"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/editor_3d_inspector"
                android:fontFamily="sans-serif-medium"/>
            <View
                android:background="@color/separator"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <ScrollView
                android:scrollbarStyle="insideOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/inspector_container"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.drawerlayout.widget.DrawerLayout>

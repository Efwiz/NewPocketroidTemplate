<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_background"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_scene_title"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/solid_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_sky_color"/>
        <Button
            android:textColor="@color/solid_white"
            android:id="@+id/btn_sky_color"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/button_background"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/solid_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_ambient_light"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">
            <SeekBar
                android:id="@+id/seekbar_ambient_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@color/solid_white"
                android:gravity="end"
                android:id="@+id/text_ambient_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:text="0.50"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/solid_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skybox"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp">
            <TextView
                android:textColor="@color/text_secondary"
                android:id="@+id/text_skybox_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="None"
                android:layout_weight="1"/>
            <Button
                android:textSize="12sp"
                android:id="@+id/btn_select_skybox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set"
                android:backgroundTint="@color/button_background"/>
            <ImageButton
                android:id="@+id/btn_clear_skybox"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#ff5252"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_shadows"/>
        <TextView
            android:textColor="@color/solid_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_shadow_dist"/>
        <EditText
            android:id="@+id/edit_shadow_distance"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:inputType="numberDecimal"
            style="@style/InspectorEditText"/>
        <TextView
            android:textColor="@color/solid_white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_shadow_res"/>
        <Spinner
            android:id="@+id/spinner_shadow_resolution"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"/>
        <CheckBox
            android:textColor="@color/solid_white"
            android:id="@+id/checkbox_csm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_shadow_csm"
            android:buttonTint="@color/accent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_csm_factor"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/solid_white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_shadow_csm_factor"/>
            <EditText
                android:id="@+id/edit_csm_factor"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:inputType="numberDecimal"
                style="@style/InspectorEditText"/>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/text_csm_hint"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="CSM splits the shadow map to prevent pixelation at distances."/>
        <Button
            android:textColor="@color/app_background"
            android:id="@+id/btn_apply_shadows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/settings_apply_btn"
            android:backgroundTint="@color/accent"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/settings_performance"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/solid_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_point_lights"/>
                <EditText
                    android:id="@+id/edit_point_lights"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:inputType="number"
                    style="@style/InspectorEditText"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/solid_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_spot_lights"/>
                <EditText
                    android:id="@+id/edit_spot_lights"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:inputType="number"
                    style="@style/InspectorEditText"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/solid_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_dir_lights"/>
                <EditText
                    android:id="@+id/edit_dir_lights"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:inputType="number"
                    style="@style/InspectorEditText"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/solid_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_bones"/>
                <EditText
                    android:id="@+id/edit_bones"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:inputType="number"
                    style="@style/InspectorEditText"/>
            </LinearLayout>
        </LinearLayout>
        <Button
            android:textColor="@color/app_background"
            android:id="@+id/btn_apply_performance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/settings_apply_perf_btn"
            android:backgroundTint="@color/accent"/>
    </LinearLayout>
</ScrollView>

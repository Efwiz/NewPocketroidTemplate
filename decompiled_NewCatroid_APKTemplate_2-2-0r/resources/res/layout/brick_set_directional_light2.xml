<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_set_directional_light_layout"
        style="@style/BrickContainer.Threed.Big">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/brick_set_directional_light_header"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_set_directional_light_dir_x"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_directional_light_dir_x_value"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_set_directional_light_dir_y"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_directional_light_dir_y_value"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_set_directional_light_dir_z"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_directional_light_dir_z_value"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_set_directional_light_intensity"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_directional_light_intensity_value"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_regex_layout"
        style="@style/BrickContainer.UserVariables.Big">
        <include layout="@layout/icon_brick_category_data"/>
        <TextView
            android:text="@string/brick_regex"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_regex2"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_regex_edit_text"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_regex3"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_regex_edit_regex"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_regex4"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/regex_userlist_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textDirection="locale"
            app:layout_newLine="true"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

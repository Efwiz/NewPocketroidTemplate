<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:background="#1e1e1e"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <HorizontalScrollView
            android:background="#2d2d30"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageButton
                    android:id="@+id/btn_open_files"
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    app:tint="#ffffff"/>
                <Button
                    android:textColor="#ffffff"
                    android:id="@+id/btn_ai_assistant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Чат с ИИ"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#6200ee"/>
                <Button
                    android:textColor="#ffffff"
                    android:id="@+id/btn_check_syntax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Проверить (Локально)"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#555555"/>
                <Button
                    android:textColor="#ffffff"
                    android:id="@+id/btn_build_cloud"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Build (Облако)"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#4caf50"/>
                <Button
                    android:textColor="#ffffff"
                    android:id="@+id/btn_create_pr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Отправить PR"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#03a9f4"/>
            </LinearLayout>
        </HorizontalScrollView>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/tabs_recycler"
            android:background="#1e1e1e"
            android:layout_width="match_parent"
            android:layout_height="35dp"/>
        <io.github.rosemoe.sora.widget.CodeEditor
            android:id="@+id/editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bottom_panel"
            android:background="#252526"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="250dp">
            <LinearLayout
                android:orientation="horizontal"
                android:background="#333333"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Ассистент ИИ / Консоль"
                    android:layout_weight="1"/>
                <ImageButton
                    android:id="@+id/btn_close_bottom_panel"
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#ffffff"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ai_chat_recycler"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:background="#1e1e1e"
                android:padding="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textColor="#ffffff"
                    android:textColorHint="#888888"
                    android:id="@+id/ai_input_field"
                    android:background="@android:color/transparent"
                    android:padding="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="Попроси добавить фичу..."
                    android:layout_weight="1"/>
                <ImageButton
                    android:id="@+id/btn_send_ai"
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/ic_menu_send"
                    app:tint="#4caf50"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#252526"
        android:padding="16dp"
        android:layout_width="280dp"
        android:layout_height="match_parent">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Файлы проекта"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/file_tree_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_layout"
        style="@style/BrickContainer.Device.Big">
        <include layout="@layout/icon_brick_category_device"/>
        <TextView
            android:text="@string/brick_create_scroll_view_title"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_create_scroll_view_id"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_id_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_scroll_view_mode"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_mode_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:text="@string/brick_create_scroll_view_bg"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_bg_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_scroll_view_bars"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_bars_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_scroll_view_padding"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_padding_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_scroll_view_overscroll"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_overscroll_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:text="X: "
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_x_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text=" Y: "
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_y_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="W: "
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_w_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text=" H: "
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_h_field"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_create_table_layout"
        style="@style/BrickContainer.Neural.Medium">
        <include layout="@layout/icon_brick_category_neural"/>
        <TextView
            android:text="@string/brick_table_to_float"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_table_to_float_table"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_table_to_float2"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_table_to_float_float"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

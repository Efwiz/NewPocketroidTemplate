<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_set_ccd_layout"
        style="@style/BrickContainer.Threed.Medium">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/brick_set_ccd"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_set_ccd_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
        <TextView
            android:text="@string/brick_set_ccd_for_object"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_ccd_object_id"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

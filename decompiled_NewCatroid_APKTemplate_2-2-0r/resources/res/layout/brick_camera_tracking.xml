<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_camera_track_layout"
        style="@style/BrickContainer.Threed.Big">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/brick_camera_track_title"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_camera_track_id"
            app:layout_newLine="true"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_camera_track_mode"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_camera_track_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/brick_camera_track_pos_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_newLine="true">
            <TextView
                android:text="@string/brick_camera_track_pos_offset"
                style="@style/BrickText.SingleLine"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="X: "
                    style="@style/BrickText.SingleLine"/>
                <TextView
                    android:id="@+id/brick_camera_track_px"
                    style="@style/BrickEditText"/>
                <TextView
                    android:layout_marginLeft="4dp"
                    android:text="Y: "
                    style="@style/BrickText.SingleLine"/>
                <TextView
                    android:id="@+id/brick_camera_track_py"
                    style="@style/BrickEditText"/>
                <TextView
                    android:layout_marginLeft="4dp"
                    android:text="Z: "
                    style="@style/BrickText.SingleLine"/>
                <TextView
                    android:id="@+id/brick_camera_track_pz"
                    style="@style/BrickEditText"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/brick_camera_track_rot_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_newLine="true">
            <TextView
                android:text="@string/brick_camera_track_rot_offset"
                style="@style/BrickText.SingleLine"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="Yaw: "
                    style="@style/BrickText.SingleLine"/>
                <TextView
                    android:id="@+id/brick_camera_track_ry"
                    style="@style/BrickEditText"/>
                <TextView
                    android:layout_marginLeft="4dp"
                    android:text="Pitch: "
                    style="@style/BrickText.SingleLine"/>
                <TextView
                    android:id="@+id/brick_camera_track_rp"
                    style="@style/BrickEditText"/>
                <TextView
                    android:layout_marginLeft="4dp"
                    android:text="Roll: "
                    style="@style/BrickText.SingleLine"/>
                <TextView
                    android:id="@+id/brick_camera_track_rr"
                    style="@style/BrickEditText"/>
            </LinearLayout>
        </LinearLayout>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

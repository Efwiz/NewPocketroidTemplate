<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_set_camera_rotation_layout"
        style="@style/BrickContainer.Look.Small">
        <include layout="@layout/icon_brick_category_look"/>
        <TextView
            android:text="@string/brick_set_camera_rotation2"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_camera_rotation_value"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_rotation_label"
            style="@style/BrickText.SingleLine"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_http_attach_file_layout"
        style="@style/BrickContainer.Internet.Big">
        <include layout="@layout/icon_brick_category_data"/>
        <TextView
            android:text="@string/brick_http_attach_file_title"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_http_attach_file_id"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_http_attach_file_id_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_http_attach_file_name"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_http_attach_file_name_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_http_attach_file_parameter"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_http_attach_file_parameter_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_http_attach_file_mime"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_http_attach_file_mime_field"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

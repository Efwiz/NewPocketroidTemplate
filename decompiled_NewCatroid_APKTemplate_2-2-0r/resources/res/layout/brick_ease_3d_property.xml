<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_ease_3d_property_layout"
        style="@style/BrickContainer.Threed.Big">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/brick_ease_3d_title"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/ease_3d_property_target_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="locale"/>
        <TextView
            android:text="@string/brick_easing_type_label"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/ease_3d_property_type_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textDirection="locale"/>
        <TextView
            android:text="@string/brick_ease_3d_object"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_ease_3d_property_object_id"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_ease_3d_start_label"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_ease_3d_property_start_edit"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_ease_3d_end_label"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_ease_3d_property_end_edit"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_ease_3d_duration_label"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_ease_3d_property_duration_edit"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

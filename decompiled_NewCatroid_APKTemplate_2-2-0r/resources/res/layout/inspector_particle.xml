<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:text="Main"
        style="@style/InspectorSubHeader"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <CheckBox
            android:textColor="@color/white"
            android:id="@+id/p_looping"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Looping"
            android:buttonTint="@color/accent"/>
    </LinearLayout>
    <include
        android:id="@+id/p_duration"
        layout="@layout/inspector_param_float"/>
    <include
        android:id="@+id/p_start_lifetime"
        layout="@layout/inspector_param_float"/>
    <include
        android:id="@+id/p_start_speed"
        layout="@layout/inspector_param_float"/>
    <include
        android:id="@+id/p_start_size"
        layout="@layout/inspector_param_float"/>
    <include
        android:id="@+id/p_gravity"
        layout="@layout/inspector_param_float"/>
    <include
        android:id="@+id/p_max_particles"
        layout="@layout/inspector_param_float"/>
    <TextView
        android:text="Emission"
        style="@style/InspectorSubHeader"/>
    <include
        android:id="@+id/p_emission_rate"
        layout="@layout/inspector_param_float"/>
    <TextView
        android:text="Shape (Cone)"
        style="@style/InspectorSubHeader"/>
    <include
        android:id="@+id/p_cone_angle"
        layout="@layout/inspector_param_float"/>
    <include
        android:id="@+id/p_cone_radius"
        layout="@layout/inspector_param_float"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start"
            android:layout_marginEnd="8dp"/>
        <Button
            android:id="@+id/p_start_color"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"/>
        <Button
            android:id="@+id/p_end_color"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <include
        android:id="@+id/p_end_size"
        layout="@layout/inspector_param_float"/>
    <include
        android:id="@+id/p_start_rotation"
        layout="@layout/inspector_param_float"/>
    <include
        android:id="@+id/p_rotation_over_lifetime"
        layout="@layout/inspector_param_float"/>
    <TextView
        android:text="Renderer"
        style="@style/InspectorSubHeader"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/slot_particle_texture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="12sp"
            android:textColor="#cccccc"
            android:ellipsize="middle"
            android:id="@+id/text_texture_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Default"
            android:singleLine="true"
            android:layout_weight="1"/>
        <Button
            android:textSize="10sp"
            android:id="@+id/btn_select_texture"
            android:layout_width="60dp"
            android:layout_height="36dp"
            android:text="Set"/>
        <ImageButton
            android:id="@+id/btn_clear_texture"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#ff5252"/>
    </LinearLayout>
    <CheckBox
        android:textColor="@color/white"
        android:id="@+id/p_is_additive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Glow (Additive)"
        android:buttonTint="@color/accent"/>
</LinearLayout>

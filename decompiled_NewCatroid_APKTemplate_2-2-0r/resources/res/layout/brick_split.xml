<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_split_layout"
        style="@style/BrickContainer.UserVariables.Big">
        <include layout="@layout/icon_brick_category_data"/>
        <TextView
            android:id="@+id/brick_split_label"
            android:text="@string/brick_split"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_split_edit_text"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_split_textview"
            android:text="@string/brick_split2"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_split_edit_simbol"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_split_textview2"
            android:text="@string/brick_split3"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/split_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textDirection="locale"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

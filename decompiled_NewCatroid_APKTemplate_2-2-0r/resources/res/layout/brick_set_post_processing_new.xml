<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_set_pp_new_layout"
        style="@style/BrickContainer.Threed.Medium">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/brick_set_post_processing_new"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_pp_effect_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_newLine="true"/>
        <Spinner
            android:id="@+id/brick_pp_param_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_newLine="true"/>
        <TextView
            android:text=" = "
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_pp_value_edit"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_interval_repeat_layout"
        style="@style/BrickContainer.Control.Medium">
        <include layout="@layout/icon_brick_category_control"/>
        <TextView
            android:text="@string/brick_interval_repeat"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_interval_repeat_edit_text_count"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/times_label_part_2"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_interval_label"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_interval_repeat_edit_text_interval"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

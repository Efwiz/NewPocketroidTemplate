<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout style="@style/BrickContainer.Sound.Small">
        <include layout="@layout/icon_brick_category_sound"/>
        <TextView
            android:text="@string/brick_stop_recording_and_save"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_recording_filename"
            app:layout_newLine="true"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_inspector_card"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_anim_clip"
        style="@style/InspectorLabel"/>
    <Spinner
        android:id="@+id/spinner_animations"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        style="@style/InspectorSpinner"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_anim_speed"
        style="@style/InspectorLabel"/>
    <EditText
        android:id="@+id/edit_anim_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="1.0"
        android:inputType="numberDecimal"
        style="@style/InspectorEditText"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_anim_transition"
        style="@style/InspectorLabel"/>
    <EditText
        android:id="@+id/edit_anim_transition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0.2"
        android:inputType="numberDecimal"
        style="@style/InspectorEditText"/>
    <CheckBox
        android:textColor="@color/solid_white"
        android:id="@+id/checkbox_anim_loop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/editor_3d_anim_loop"
        android:buttonTint="@color/accent"/>
</LinearLayout>

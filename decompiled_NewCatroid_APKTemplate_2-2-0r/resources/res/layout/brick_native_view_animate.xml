<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_layout"
        style="@style/BrickContainer.Device.Big">
        <include layout="@layout/icon_brick_category_device"/>
        <TextView
            android:text="@string/brick_native_view_animate_title"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_native_view_animate_id"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_id_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_native_view_animate_prop"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_property_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:text="@string/brick_native_view_animate_val"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_value_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_native_view_animate_duration"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_duration_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_native_view_animate_easing"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_easing_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

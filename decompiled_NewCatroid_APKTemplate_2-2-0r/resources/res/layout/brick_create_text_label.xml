<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_layout"
        style="@style/BrickContainer.Device.Big">
        <include layout="@layout/icon_brick_category_device"/>
        <TextView
            android:text="@string/brick_create_text_label_title"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_create_text_label_id"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_id_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_text_label_text"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_text_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_text_label_color"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_color_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_text_label_size"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_size_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_text_label_bg"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_bg_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_text_label_radius"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_radius_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_text_label_font"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_font_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_text_label_spacing"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_spacing_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_create_text_label_format"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_format_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:text="@string/brick_create_text_label_align"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_align_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:text="@string/brick_create_text_label_scroll"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_scroll_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:text="X: "
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_x_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text=" Y: "
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_y_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text="W: "
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_w_field"
            style="@style/BrickEditText"/>
        <TextView
            android:text=" H: "
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_h_field"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

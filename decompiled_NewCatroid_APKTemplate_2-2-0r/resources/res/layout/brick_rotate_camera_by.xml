<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_rotate_camera_by_layout"
        style="@style/BrickContainer.Threed.Medium">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/brick_rotate_camera_by"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_rotate_pitch"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/rotate_pitch_edit"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_rotate_yaw"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/rotate_yaw_edit"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_rotate_roll"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/rotate_roll_edit"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

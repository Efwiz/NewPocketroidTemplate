<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/editor_3d_light_type"
        style="@style/InspectorLabel"/>
    <Spinner
        android:id="@+id/spinner_light_type"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        style="@style/InspectorSpinner"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/editor_3d_light_intensity"
        style="@style/InspectorLabel"/>
    <EditText
        android:id="@+id/edit_light_intensity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:inputType="numberDecimal"
        style="@style/InspectorEditText"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_light_range"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/editor_3d_light_range"
            style="@style/InspectorLabel"/>
        <EditText
            android:id="@+id/edit_light_range"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:inputType="numberDecimal"
            style="@style/InspectorEditText"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_light_spot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/editor_3d_light_cutoff"
            style="@style/InspectorLabel"/>
        <EditText
            android:id="@+id/edit_light_angle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:inputType="numberDecimal"
            style="@style/InspectorEditText"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/editor_3d_light_exponent"
            style="@style/InspectorLabel"/>
        <EditText
            android:id="@+id/edit_light_exponent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:inputType="numberDecimal"
            style="@style/InspectorEditText"/>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/editor_3d_light_color"
        style="@style/InspectorLabel"/>
    <Button
        android:textColor="@color/solid_white"
        android:id="@+id/btn_light_color"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:text="@string/editor_3d_light_select_color"
        android:backgroundTint="@color/button_background"/>
</LinearLayout>

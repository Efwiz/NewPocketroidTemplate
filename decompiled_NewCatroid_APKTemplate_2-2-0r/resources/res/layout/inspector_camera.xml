<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_inspector_card"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <CheckBox
        android:textColor="@color/solid_white"
        android:id="@+id/check_main_camera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_cam_main"
        android:buttonTint="@color/accent"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_cam_fov"
        style="@style/InspectorLabel"/>
    <EditText
        android:id="@+id/edit_cam_fov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:inputType="numberDecimal"
        style="@style/InspectorEditText"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_cam_clipping"
        style="@style/InspectorLabel"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        <TextView
            android:textColor="@color/accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Near "/>
        <EditText
            android:id="@+id/edit_cam_near"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            style="@style/InspectorEditText"/>
        <TextView
            android:textColor="@color/accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Far "
            android:layout_marginStart="8dp"/>
        <EditText
            android:id="@+id/edit_cam_far"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            style="@style/InspectorEditText"/>
    </LinearLayout>
</LinearLayout>

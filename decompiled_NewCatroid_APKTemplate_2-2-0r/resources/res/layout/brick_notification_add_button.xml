<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_layout"
        style="@style/BrickContainer.Device.Big">
        <include layout="@layout/icon_brick_category_device"/>
        <TextView
            android:text="@string/brick_notif_btn_title"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_notif_btn_id"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_notif_btn_id"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_notif_btn_action"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_notif_btn_action"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_notif_btn_text"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_notif_btn_text"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_notif_btn_icon"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_notif_btn_icon"
            style="@style/BrickEditText"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_newLine="true">
            <TextView
                android:text="@string/brick_notif_btn_behavior"
                style="@style/BrickText.SingleLine"/>
            <Spinner
                android:id="@+id/brick_notif_btn_spinner_behavior"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <CheckBox
            android:textColor="#ffffff"
            android:id="@+id/brick_notif_btn_checkbox_input"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brick_notif_btn_has_input"
            android:buttonTint="#ffffff"
            app:layout_newLine="true"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/brick_notif_btn_hint_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_newLine="true">
            <TextView
                android:text="@string/brick_notif_btn_hint"
                style="@style/BrickText.SingleLine"/>
            <TextView
                android:id="@+id/brick_notif_btn_hint"
                style="@style/BrickEditText"/>
        </LinearLayout>
        <CheckBox
            android:textColor="#ffffff"
            android:id="@+id/brick_notif_btn_checkbox_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/brick_notif_btn_auto_close"
            android:buttonTint="#ffffff"
            app:layout_newLine="true"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

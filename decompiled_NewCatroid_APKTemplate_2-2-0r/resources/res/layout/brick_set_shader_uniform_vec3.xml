<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_set_uniform_vec3_layout"
        style="@style/BrickContainer.Threed.Big">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/brick_set_shader_uniform_vec3"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_shader_uniform_name"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_uniform_name_edit"
            style="@style/BrickEditText"/>
        <TextView
            android:text="X:"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_uniform_value_x_edit"
            style="@style/BrickEditText"/>
        <TextView
            android:text="Y:"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_uniform_value_y_edit"
            style="@style/BrickEditText"/>
        <TextView
            android:text="Z:"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_uniform_value_z_edit"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/toolbar"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/bottom_bar"
            android:background="@drawable/bottom_bar_background_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/scratch_converter_bottom_bar_height"
            android:layout_alignParentBottom="true"
            android:paddingStart="@dimen/view_holder_padding"
            android:paddingEnd="@dimen/view_holder_padding">
            <TextView
                android:textSize="?attr/small"
                android:textStyle="bold"
                android:id="@+id/title_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="?attr/small"
                android:textStyle="italic"
                android:id="@+id/details_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottom_bar"/>
    </RelativeLayout>
</LinearLayout>

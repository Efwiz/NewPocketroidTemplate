<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    app:strokeColor="@color/accent"
    app:strokeWidth="1.5dp">
    <ScrollView
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/view_holder_item_title"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/community_publish_title"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPublishTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="@string/project_name_label"
                style="@style/Widget.NewCatroid.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:textColor="@color/solid_white"
                    android:id="@+id/etPublishTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPublishDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="@string/community_publish_desc_hint"
                style="@style/Widget.NewCatroid.TextInputLayout">
                <com.google.android.material.textfield.TextInputEditText
                    android:textColor="@color/solid_white"
                    android:gravity="top"
                    android:id="@+id/etPublishDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:inputType="textMultiLine"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:textSize="12sp"
                android:textStyle="italic|bold"
                android:textColor="@color/accent"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvPublishRulesLink"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/community_publish_rules_link"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/view_holder_item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/community_publish_genres"/>
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPublishGenres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"/>
            <com.google.android.material.button.MaterialButton
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/app_background_dark"
                android:id="@+id/btnSubmitPublish"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/community_publish_start"
                app:backgroundTint="@color/accent"
                app:cornerRadius="16dp"/>
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>

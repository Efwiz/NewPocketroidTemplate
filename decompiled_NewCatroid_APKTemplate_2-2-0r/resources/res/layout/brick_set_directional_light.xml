<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_set_directional_light_layout"
        style="@style/BrickContainer.Threed.Big">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/brick_set_directional_light_id"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_directional_light_id"
            app:layout_newLine="true"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_set_directional_light_color"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text=" R:"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_directional_light_r"
            style="@style/BrickEditText"/>
        <TextView
            android:text=" G:"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_directional_light_g"
            style="@style/BrickEditText"/>
        <TextView
            android:text=" B:"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_directional_light_b"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_set_directional_light_dir"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text=" X:"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_directional_light_x"
            style="@style/BrickEditText"/>
        <TextView
            android:text=" Y:"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_directional_light_y"
            style="@style/BrickEditText"/>
        <TextView
            android:text=" Z:"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_directional_light_z"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_create_web_file_layout"
        style="@style/BrickContainer.Device.Big">
        <include layout="@layout/icon_brick_category_device"/>
        <TextView
            android:text="@string/brick_video_player"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/create_video_name"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/project_file"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/create_video_file"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/position"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/create_video_x"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/create_video_y"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/size_wh"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/create_video_width"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/create_video_height"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/loop_enabled"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/create_video_loop"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/control_enabled"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/create_video_control"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

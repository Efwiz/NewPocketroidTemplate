<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_set_fog_layout"
        style="@style/BrickContainer.Threed.Big">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/brick_set_3d_fog"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/brick_3d_fog_r"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_fog_r_edit"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_3d_fog_g"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_fog_g_edit"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_3d_fog_b"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_fog_b_edit"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_3d_fog_density"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_fog_density_edit"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_set_buffer_effects_layout"
        style="@style/BrickContainer.Look.Medium">
        <include layout="@layout/icon_brick_category_look"/>
        <TextView
            android:text="@string/brick_buffer_fx_title"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_buffer_fx_name"
            style="@style/BrickEditText"/>
        <TextView
            android:text="3D PostProcessing (0/1):"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_buffer_fx_vfx"
            style="@style/BrickEditText"/>
        <TextView
            android:text="Mipmapping (0/1):"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_buffer_fx_mip"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

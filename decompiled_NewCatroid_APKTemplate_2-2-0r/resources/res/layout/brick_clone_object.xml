<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_clone_object_layout"
        style="@style/BrickContainer.Threed.Medium">
        <include layout="@layout/icon_brick_category_threed"/>
        <TextView
            android:text="@string/brick_clone_object"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_clone_source_edit"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_clone_as"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_clone_new_name_edit"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

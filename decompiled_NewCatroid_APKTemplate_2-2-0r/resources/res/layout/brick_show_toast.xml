<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_show_toast_layout"
        style="@style/BrickContainer.Device.Small">
        <include layout="@layout/icon_brick_category_device"/>
        <TextView
            android:id="@+id/brick_show_toast_label"
            android:text="@string/brick_show_toast"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_show_toast_edit_text"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_show_toast_textview"
            android:text="@string/brick_show_toast2"
            style="@style/BrickText.SingleLine"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

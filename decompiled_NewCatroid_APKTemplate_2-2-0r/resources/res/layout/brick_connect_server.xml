<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_connect_server_layout"
        style="@style/BrickContainer.Internet.Medium">
        <include layout="@layout/icon_brick_category_internet"/>
        <TextView
            android:id="@+id/brick_connect_server_label"
            android:text="@string/brick_connect_server"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_connect_server_label2"
            android:text="@string/brick_connect_server2"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_connect_server_edit_ip"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_connect_server_label3"
            android:text="@string/brick_connect_server3"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_connect_server_edit_port"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

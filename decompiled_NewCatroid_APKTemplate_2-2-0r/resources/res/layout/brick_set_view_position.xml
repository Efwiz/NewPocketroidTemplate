<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_set_view_position_layout"
        style="@style/BrickContainer.Device.Medium">
        <include layout="@layout/icon_brick_category_device"/>
        <TextView
            android:text="@string/brick_set_view_position"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_view_position_id"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_x_label"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_view_position_x"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_y_label"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_set_view_position_y"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_inspector_card"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_mat_color"
        style="@style/InspectorLabel"/>
    <Button
        android:id="@+id/btn_material_color"
        android:background="@drawable/bg_inspector_input"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"/>
    <include
        android:id="@+id/slot_base_color_texture"
        layout="@layout/inspector_texture_slot"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_mat_metallic"
        style="@style/InspectorLabel"/>
    <include
        android:id="@+id/slider_metallic"
        layout="@layout/inspector_slider"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_mat_roughness"
        style="@style/InspectorLabel"/>
    <include
        android:id="@+id/slider_roughness"
        layout="@layout/inspector_slider"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_mat_emissive"
        style="@style/InspectorLabel"/>
    <Button
        android:id="@+id/btn_emissive_color"
        android:background="@drawable/bg_inspector_input"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"/>
    <include
        android:id="@+id/slot_emissive_texture"
        layout="@layout/inspector_texture_slot"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_mat_normal"
        style="@style/InspectorLabel"/>
    <include
        android:id="@+id/slot_normal_texture"
        layout="@layout/inspector_texture_slot"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_mat_met_rough"
        style="@style/InspectorLabel"/>
    <include
        android:id="@+id/slot_mr_texture"
        layout="@layout/inspector_texture_slot"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/editor_3d_mat_occlusion"
        style="@style/InspectorLabel"/>
    <include
        android:id="@+id/slot_occlusion_texture"
        layout="@layout/inspector_texture_slot"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/material_params_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_fast2d_set_texture_layout"
        style="@style/BrickContainer.Fast2d.Medium">
        <include layout="@layout/icon_brick_category_fast2d"/>
        <TextView
            android:text="@string/fast2d_set_texture"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:text="@string/fast2d_id_param"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_fast2d_set_texture_id"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/fast2d_file_param"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_fast2d_set_texture_file"
            style="@style/BrickEditText"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <CheckBox
        android:gravity="center_vertical"
        android:id="@+id/brick_checkbox"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <org.catrobat.catroid.ui.BrickLayout
        android:id="@+id/brick_show_text_rotation_layout"
        style="@style/BrickContainer.UserVariables.Big">
        <include layout="@layout/icon_brick_category_data"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_label"
            android:text="@string/brick_show_text"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_edit_text"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_label2"
            android:text="@string/brick_show_name"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_edit_name"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_at_label"
            android:text="@string/brick_show_variable_position"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_x_textview"
            android:text="@string/x_label"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_edit_x"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_y_textview"
            android:text="@string/y_label"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_edit_y"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_with_textview"
            android:text="@string/brick_show_variable_size"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_edit_size"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_percent_textview"
            android:text="@string/percent_symbol"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_color_size_and_textview"
            android:text="@string/brick_show_variable_color"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_edit_color"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_show_text_font"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_edit_font"
            style="@style/BrickEditText"/>
        <TextView
            android:text="@string/brick_show_text_rotation"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_edit_rotation"
            style="@style/BrickEditText"/>
        <TextView
            android:id="@+id/brick_show_text_rotation_spinner_text"
            android:text="@string/brick_show_variable_aligned"
            app:layout_newLine="true"
            style="@style/BrickText.SingleLine"/>
        <Spinner
            android:id="@+id/brick_show_text_rotation_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textDirection="locale"/>
    </org.catrobat.catroid.ui.BrickLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@color/app_background"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">
            <include
                android:id="@+id/toolbar"
                layout="@layout/toolbar"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/content_container"
                android:padding="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="true"
                    style="@style/NewCatroid.TextInputLayout">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textSize="18sp"
                        android:textColor="@color/solid_white"
                        android:id="@+id/input_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/standard_settings_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/accent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Ориентация проекта"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"/>
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/orientation_toggle_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:checkedButton="@+id/btn_portrait"
                        app:selectionRequired="true"
                        app:singleSelection="true">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_portrait"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:text="@string/new_project_dialog_portrait"
                            android:layout_weight="1"
                            app:icon="@drawable/ic_smartphone_dialog_orientation_portrait"
                            style="@style/Widget.NewCatroid.ToggleButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_landscape"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:text="@string/new_project_dialog_landscape"
                            android:layout_weight="1"
                            app:icon="@drawable/ic_smartphone_dialog_orientation_landscape"
                            style="@style/Widget.NewCatroid.ToggleButton"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:textColor="@color/solid_white"
                        android:id="@+id/example_project_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/new_project_dialog_example_project"
                        app:thumbTint="@color/accent"/>
                </LinearLayout>
                <View
                    android:background="@color/button_background"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"/>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:id="@+id/git_clone_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Клонировать репозиторий Git"
                    app:thumbTint="@color/accent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/git_input_container"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Remote URL"
                        style="@style/NewCatroid.TextInputLayout">
                        <com.google.android.material.textfield.TextInputEditText
                            android:textColor="@color/solid_white"
                            android:id="@+id/git_url_edit_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Access Token (optional)"
                        style="@style/NewCatroid.TextInputLayout">
                        <com.google.android.material.textfield.TextInputEditText
                            android:textColor="@color/solid_white"
                            android:id="@+id/git_token_edit_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/git_progress_bar"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent"
                    style="?android:attr/progressBarStyleHorizontal"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <org.catrobat.catroid.utils.BorderTextView
        android:textSize="@dimen/text_size_large"
        android:textColor="@color/formula_editor_intro_heading_color"
        android:gravity="center"
        android:id="@+id/intro_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:textAlignment="center"/>
    <ScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="50dp">
        <org.catrobat.catroid.utils.BorderTextView
            android:textSize="@dimen/text_size_medium"
            android:textColor="@color/solid_white"
            android:gravity="center"
            android:id="@+id/intro_dialog_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textAlignment="center"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Button
            android:textSize="@dimen/text_size_large"
            android:textColor="@color/solid_white"
            android:id="@+id/intro_dialog_skip_button"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/skip"
            android:layout_weight="1"
            android:textAllCaps="true"
            android:fontFamily="sans-serif"
            android:layout_marginStart="20dp"
            style="?android:attr/buttonBarButtonStyle"/>
        <Button
            android:textSize="@dimen/text_size_large"
            android:textColor="@color/solid_white"
            android:id="@+id/intro_dialog_next_button"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next"
            android:layout_weight="1"
            android:textAllCaps="true"
            android:fontFamily="sans-serif"
            android:layout_marginEnd="20dp"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>
</LinearLayout>

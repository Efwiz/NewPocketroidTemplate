<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/mlkit_asr_background_corner"
    android:paddingTop="@dimen/mlkit_asr_text_margin_top"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/mlkit_asr_dialog_height"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="@dimen/mlkit_asr_text_margin_top"
    android:layoutDirection="ltr"
    android:paddingHorizontal="16dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/contentPanel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mlkit_asr_text_height">
            <com.huawei.hms.mlplugin.asr.view.EllipsizeTextView
                android:textSize="18sp"
                android:textColor="#80000000"
                android:gravity="center_horizontal"
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:shadowColor="@android:color/black"
                android:shadowDx="0.25"
                android:shadowDy="0.25"
                android:shadowRadius="1"
                android:layout_centerHorizontal="true"
                android:lineSpacingMultiplier="1.05"/>
        </RelativeLayout>
        <com.huawei.hms.mlplugin.asr.view.VoiceWaveView
            android:id="@+id/waveLineView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/mlkit_asr_wave_view_height"
            android:layout_below="@+id/contentPanel"
            app:wlvBackgroundColor="@android:color/transparent"
            app:wlvLineColor="@android:color/holo_blue_light"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/copyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/logo"
                android:layout_width="@dimen/mlkit_asr_logo_height"
                android:layout_height="12dp"
                android:src="@mipmap/mlkit_asr_huawei_logo_gray"
                android:scaleType="fitXY"
                android:alpha="1"/>
            <TextView
                android:textSize="@dimen/mlkit_asr_mlkit_text_size"
                android:textColor="#60000000"
                android:layout_gravity="center_horizontal"
                android:id="@+id/provider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/mlkit_asr_machine_learning_kit"
                android:shadowColor="@android:color/black"
                android:shadowDx="0.25"
                android:shadowDy="0.25"
                android:shadowRadius="1"
                android:alpha="0.5"/>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
